###read all users
GET http://localhost:6000/user-api/users



###read a user by id
GET http://localhost:6000/user-api/users/12


###create new user
POST http://localhost:6000/user-api/users
Content-Type: application/json   

{   
    "id":1,
    "name":"Sam",
    "age":19
}



###update a user
PUT http://localhost:6000/user-api/users
Content-Type: :application/json

{   
    "id":1,
    "name":"Bhanu",
    "age":22
}

###delete a user by id
DELETE http://localhost:6000/user-api/users/1



###---------------------------------------------------------------###
###create new product
POST http://localhost:6000/product-api/products
Content-Type: application/json

{
"productId":3,
"name":"Oil",
"brand":"Sunflower",
"price":180
}


###read all products
GET http://localhost:6000/product-api/products


###Read all products by brand
GET http://localhost:6000/product-api/products/freedom


###Update a product
PUT http://localhost:6000/product-api/products
Content-Type: application/json

{
"productId":1,
"name":"Oil",
"brand":"Freedom",
"price":150
}


###delete a product by id 
DELETE http://localhost:6000/product-api/products/2
